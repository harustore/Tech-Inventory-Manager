{
  "installCommand": "corepack enable && pnpm install",
  "buildCommand": "node artifacts/api-server/build-vercel.mjs && pnpm --filter @workspace/techstock run build",
  "outputDirectory": "artifacts/techstock/dist",
  "framework": null,
  "functions": {
    "api/index.cjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.cjs"
    }
  ]
}